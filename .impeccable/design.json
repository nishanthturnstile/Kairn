      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Commits the main task; pending keeps this label and blocks repeat activation.",
      "html": "<button type=\"button\" class=\"ds-button ds-primary\">Save changes</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;min-width:44px;min-height:44px;padding:8px 16px;border:1px solid transparent;border-radius:var(--kairn-control-radius,6px);font:600 16px/1.5 var(--kairn-typography-family-interface,\"Instrument Sans\"),sans-serif;white-space:normal;overflow-wrap:anywhere;cursor:pointer;transition:background-color var(--kairn-motion-feedback,120ms) var(--kairn-motion-ease,cubic-bezier(0.16,1,0.3,1))}.ds-button:hover:not(:disabled){filter:brightness(.94)}.ds-button:active:not(:disabled){filter:brightness(.9)}.ds-button:focus-visible{outline:var(--kairn-focus-width,3px) solid var(--ring,#164D70);outline-offset:var(--kairn-focus-offset,2px)}.ds-button:disabled,.ds-button[aria-disabled=\"true\"]{opacity:.55;cursor:default}.ds-button[aria-busy=\"true\"]{cursor:progress;border-style:dashed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--primary,#164D70);color:var(--primary-foreground,#FFFFFF);border-color:var(--primary,#164D70)}"
    },
