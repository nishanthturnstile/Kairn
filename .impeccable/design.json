  "narrative": {
    "northStar": "Open atlas",
    "overview": "Chronology makes a remembered journey understandable. Open atlas keeps time and place beside photographs, personal accounts and dated practical details. Mineral canvas, white surfaces, deep blue actions and slate text give the content a calm frame; Newsreader supplies the reading voice and Instrument Sans keeps controls precise.\n\nEach composition serves its task: account forms follow a narrow sequence, the workspace groups edits and permissions, and the reader places a chapter spine beside focused content. Rest days, transfers and unknown locations belong in the same chronology. Essential labels stay outside photographs, and missing route evidence remains a visible gap.\n\nThis contract merges the implemented component system into the selected Open atlas direction. It does not close the DS01–DS12 plan or establish native runtime acceptance. The product requirements, application design and implementation records retain authority over behavior, permissions and acceptance.",
    "keyCharacteristics": [
      "Chronology with explicit dates, pauses and unknown locations.",
      "Calm broad surfaces with precise, small-corner controls.",
      "One semantic light/dark system with platform-owned components.",
      "Visible labels, stable action names and adjacent source context."
    ],
    "rules": [
      {
        "name": "Semantic Role",
        "body": "Choose a semantic role for meaning, map it in both appearances, and let the platform adapter apply it. Do not add screen-level color literals or new consumers of legacy palette aliases.",
        "section": "colors"
      },
      {
        "name": "Two Voices",
        "body": "Use Newsreader for expressive journey titles and Instrument Sans for instructions, controls and prose. Use the bundled native weight names rather than synthetic bold.",
        "section": "typography"
      },
      {
        "name": "Layer With Purpose",
        "body": "Use a surface, divider or scrim to explain grouping and layers. Do not add elevation merely to decorate routine controls or chapter rows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do make chronology understandable with time, place, rest days and explicit uncertainty.",
      "Do reuse semantic roles and the canonical platform controls before adding a token or variant.",
      "Do preserve labels, drafts and chapter selection through pending states, failures and appearance changes.",
      "Do pair selected, review, error and route-evidence colors with visible text or non-color cues.",
      "Do keep ownership, coauthor authority, publication permission and original-file export distinct.",
      "Do label fictional samples and generated demonstration imagery honestly, with provenance."
    ],
    "donts": [
      "Don't place essential labels on photographs or unpredictable map backgrounds.",
      "Don't turn every section into a card, a metric hero or decorative cartography.",
      "Don't connect unknown geometry or present an illustrative route diagram as a geographical map.",
      "Don't use autoplay, scroll hijacking or 3D as prerequisites for reading.",
      "Don't describe session-only prototype changes as durable saving, contribution or publication.",
      "Don't treat screenshots, Metro exports or responsive web checks as Android or iOS runtime acceptance."
    ]
  }
}
