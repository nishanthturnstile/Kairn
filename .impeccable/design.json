      "html": "<fieldset class=\"ds-segments\"><legend>Reader view</legend><label><input type=\"radio\" name=\"ds-reader-view\" checked><span>Story</span></label><label><input type=\"radio\" name=\"ds-reader-view\"><span>Explore</span></label><label><input type=\"radio\" name=\"ds-reader-view\"><span>Learn</span></label></fieldset>",
      "css": ".ds-segments{display:flex;flex-wrap:wrap;gap:4px;margin:0;padding:4px;border:1px solid var(--input,#637684);border-radius:6px;color:var(--foreground,#172D3B);font:600 16px/1.5 var(--kairn-typography-family-interface,\"Instrument Sans\"),sans-serif}.ds-segments legend{font-size:14px}.ds-segments label{position:relative;flex:1;min-width:min-content;cursor:pointer}.ds-segments input{position:absolute;inset:0;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}.ds-segments span{display:flex;align-items:center;justify-content:center;min-height:44px;padding:8px 12px;border-radius:6px}.ds-segments input:checked+span{background:var(--selected,#E0EDF5);color:var(--primary,#164D70)}.ds-segments input:focus-visible+span{outline:3px solid var(--ring,#164D70);outline-offset:-3px}.ds-segments label:hover span{background:var(--selected,#E0EDF5)}"
