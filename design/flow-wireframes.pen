        },
        {
          "type": "text",
          "id": "U1Jip",
          "name": "Return",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "BACK / CANCEL: 21 retains candidate and operation reference; leaving does not cancel a submitted request.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "rtGgm",
          "name": "Rights and recovery",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Confirmed result returns to source 21 with accepted revision and review-required status accurately updated. Known pre-submit failure: Retry same logical operation; offline: Waiting to send, not saved. Unknown outcome: reconcile same identity. Browser local retention is qualified, not native durable-save evidence. Inputs are simulated.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "WZQZ6",
          "name": "Focus and layout",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Focus heading on navigation; error summary then first invalid field on failure. Native Back and browser Back preserve the validated caller/position. Modal discard confirmation returns focus to trigger. 48px targets; logical label/choice/action order. Large text scrolls without horizontal overflow; focused fields and actions stay above keyboard. No permission via UI alone.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "hc0Hl",
          "name": "Browser boundary",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Own browser authentication required. Re-fetch same entity and current rights. Browser candidate persistence may fail or be evicted; disclose retention honestly. No native credentials or unsaved bytes carried in URL.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
