        {
          "type": "text",
          "id": "v2Q0X5",
          "name": "Rights and recovery",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "No request-message command or “become editor” control. Existing issue stays visible. Leela independently opens same issue at R07 under her own session. Publisher refresh waits for actual accepted repair. Source withdrawn mid-inspection → R18; no cached protected preview.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "LSSmF",
          "name": "Focus and layout",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Focus heading on navigation; error summary then first invalid field on failure. Native Back and browser Back preserve the validated caller/position. Modal discard confirmation returns focus to trigger. 48px targets; logical label/choice/action order. Large text scrolls without horizontal overflow; focused fields and actions stay above keyboard. No permission via UI alone.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "YBLyS",
          "name": "Browser boundary",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Own browser authentication required. Re-fetch same entity and current rights. Browser candidate persistence may fail or be evicted; disclose retention honestly. No native credentials or unsaved bytes carried in URL.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
