        },
        {
          "type": "text",
          "id": "LyaI2",
          "name": "Forward",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Sign in → E02 if required → authorized R08W\nCancel → safe web history / native unchanged\nRecovery/create account → existing E03/E01 variants\nPermission denied → R18W\nNo automatic repair submission.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "z1cLQy",
          "name": "Return",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "BACK / CANCEL: Native returns to R08N with retained candidate and repair context.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "u8u5eS",
          "name": "Rights and recovery",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "N: Save-before-continuing checks/reconciles accepted changes; otherwise retain candidate and warn browser starts current server revision. W: independent E01/E02 sign-in resolves safe return to R08W after rechecking rights, never automatically saves/excludes/publishes. Expiry/denial → R18W; cancelled sign-in leaves native untouched. Static scenario does not sync devices.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "XFtT9",
          "name": "Focus and layout",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Focus heading on navigation; error summary then first invalid field on failure. Native Back and browser Back preserve the validated caller/position. Modal discard confirmation returns focus to trigger. 48px targets; logical label/choice/action order. Large text scrolls without horizontal overflow; focused fields and actions stay above keyboard. No permission via UI alone.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "GIcaZ",
          "name": "Browser boundary",
          "fill": "#222222",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Own browser authentication required. Re-fetch same entity and current rights. Browser candidate persistence may fail or be evicted; disclose retention honestly. No native credentials or unsaved bytes carried in URL.",
          "lineHeight": 1.3,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
