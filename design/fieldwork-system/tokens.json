  "typography": {
    "heading": "Fraunces",
    "ui": "Geist",
    "label": 13,
    "webUi": 14,
    "nativeUi": 16,
    "reading": 18,
    "note": "Fraunces is editorial; controls, labels and data use Geist. Type scales and wraps."
  },
  "controls": {
    "webMinHeight": 36,
    "touchMinTarget": 48,
    "richNativeRowMinHeight": 56,
    "focusWidth": 2,
    "focusSeparation": 3,
    "note": "Values are minimums; multi-line labels and larger type grow. Coarse-pointer web uses touch targets."
  },
  "colorRules": {
    "bodyText": "ink or muted on paper, surface or mist",
    "links": "link, with underline or an equivalent non-color cue",
    "filledActions": "onAction on action or actionHover",
    "feedback": "Semantic heading and seam: good/goodBg, warn/warnBg, error/errorBg. Supporting text may use ink/muted on those surfaces.",
    "boundaries": "boundary for controls; line only for decorative separators",
    "map": "mapRoute and mapLabel on mapBase/mapLand; opaque surface + semantic text over satellite/photo imagery",
    "brand": "Raw foundation swatches are not unrestricted text colors"
  },
  "motion": {
    "pressMs": 120,
    "contextMs": 180,
    "disclosureMs": 220,
    "reducedMotion": "No spatial movement or camera flight; immediate state or short fade",
    "keyboard": "Immediate selection",
    "hover": "Only devices supporting hover"
  },
