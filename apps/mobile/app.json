{
  "expo": {
    "name": "Kairn Dev",
    "slug": "kairn-dev",
    "version": "0.0.0",
    "scheme": "kairn-dev",
    "platforms": ["android", "ios"],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "dev.kairn.app"
    },
    "ios": {
      "bundleIdentifier": "dev.kairn.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your private Kairn avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-optional-camera.cjs",
      "expo-web-browser"
    ]
  }
}
