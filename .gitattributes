* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
# Preserve generated patch headers/context; pnpm hashes their exact bytes.
patches/*.patch whitespace=-blank-at-eol
# Preserve pinned upstream license notices byte-for-byte.
apps/web/src/assets/fonts/*-OFL.txt whitespace=-blank-at-eol
