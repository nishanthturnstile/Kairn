KAIRN_HTTP_PORT=8080
KAIRN_PUBLIC_ORIGIN=http://localhost:8080
KAIRN_LOG_LEVEL=info
KAIRN_MAILPIT_PORT=8025

# Local development defaults only. Supply independent values before any shared deployment.
# PostgreSQL role passwords apply on a new volume; rotate existing roles explicitly.
# When changing passwords, also set the matching URL with URL-encoded credentials.
KAIRN_POSTGRES_PASSWORD=kairn-postgres-local-only
KAIRN_MIGRATOR_PASSWORD=kairn-migrator-local
KAIRN_SERVER_DB_PASSWORD=kairn-server-local
KAIRN_WORKER_DB_PASSWORD=kairn-worker-local
KAIRN_MIGRATION_DATABASE_URL=postgresql://kairn_migrator:kairn-migrator-local@postgres:5432/kairn
KAIRN_SERVER_DATABASE_URL=postgresql://kairn_server:kairn-server-local@postgres:5432/kairn
KAIRN_WORKER_DATABASE_URL=postgresql://kairn_worker:kairn-worker-local@postgres:5432/kairn
KAIRN_STORAGE_ACCESS_KEY=kairn-local
KAIRN_STORAGE_SECRET_KEY=kairn-storage-local-only
