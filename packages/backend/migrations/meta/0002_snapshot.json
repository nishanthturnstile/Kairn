          "name": "journey_title_check",
          "value": "\"journeys\".\"journey\".\"title\" IS NULL OR (char_length(\"journeys\".\"journey\".\"title\") BETWEEN 1 AND 160 AND \"journeys\".\"journey\".\"title\" = btrim(\"journeys\".\"journey\".\"title\"))"
