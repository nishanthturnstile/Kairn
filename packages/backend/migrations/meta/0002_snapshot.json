        "journey_details_check": {
          "name": "journey_details_check",
          "value": "\"journeys\".\"journey\".\"lifecycle\" = 'deleted' OR (\"journeys\".\"journey\".\"title\" IS NOT NULL AND \"journeys\".\"journey\".\"time_zone\" IS NOT NULL AND \"journeys\".\"journey\".\"start_local\" IS NOT NULL AND \"journeys\".\"journey\".\"start_at\" IS NOT NULL AND \"journeys\".\"journey\".\"start_offset_minutes\" IS NOT NULL)"
        },
        "journey_category_check": {
          "name": "journey_category_check",
          "value": "\"journeys\".\"journey\".\"category\" IS NULL OR \"journeys\".\"journey\".\"category\" IN ('hike_trek', 'cycling', 'road_journey', 'other')"
        },
        "journey_start_check": {
          "name": "journey_start_check",
          "value": "(\"journeys\".\"journey\".\"start_local\" IS NULL AND \"journeys\".\"journey\".\"start_at\" IS NULL AND \"journeys\".\"journey\".\"start_offset_minutes\" IS NULL) OR (\"journeys\".\"journey\".\"start_local\" IS NOT NULL AND \"journeys\".\"journey\".\"start_at\" IS NOT NULL AND \"journeys\".\"journey\".\"start_offset_minutes\" IS NOT NULL AND \"journeys\".\"journey\".\"start_offset_minutes\" BETWEEN -840 AND 840 AND \"journeys\".\"journey\".\"start_local\" ~ '^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$' AND \"journeys\".\"journey\".\"start_at\" >= timestamptz '0001-01-01 00:00:00+00' AND \"journeys\".\"journey\".\"start_at\" < timestamptz '10000-01-01 00:00:00+00' AND extract(second FROM \"journeys\".\"journey\".\"start_at\" AT TIME ZONE 'UTC') = 0)"
        },
