        "account_state_check": {
          "name": "account_state_check",
          "value": "\"identity\".\"account\".\"state\" IN ('active', 'deleting', 'deleted')"
        },
        "active_account_auth_mapping": {
          "name": "active_account_auth_mapping",
          "value": "\"identity\".\"account\".\"state\" <> 'active' OR \"identity\".\"account\".\"auth_subject_id\" IS NOT NULL"
        },
        "account_revision_check": {
          "name": "account_revision_check",
          "value": "\"identity\".\"account\".\"revision\" BETWEEN 1 AND 9007199254740991 AND \"identity\".\"account\".\"policy_generation\" BETWEEN 1 AND 9007199254740991"
        },
        "account_deletion_time_check": {
          "name": "account_deletion_time_check",
          "value": "(\"identity\".\"account\".\"state\" = 'active' AND \"identity\".\"account\".\"deleted_at\" IS NULL) OR (\"identity\".\"account\".\"state\" <> 'active' AND \"identity\".\"account\".\"deleted_at\" IS NOT NULL)"
        }
