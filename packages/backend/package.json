{
  "name": "@kairn/backend",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./job-producer": {
      "types": "./dist/job-producer.d.ts",
      "import": "./dist/job-producer.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./auth-options": {
      "types": "./dist/auth-options.d.ts",
      "import": "./dist/auth-options.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./journal": {
      "types": "./dist/journal.d.ts",
      "import": "./dist/journal.js"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "import": "./dist/mail.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    },
    "./worker-config": {
      "types": "./dist/worker-config.d.ts",
      "import": "./dist/worker-config.js"
    },
    "./journal-server": {
      "types": "./dist/journal-server.d.ts",
      "import": "./dist/journal-server.js"
    },
    "./auth-adapter": {
      "types": "./dist/auth-adapter.d.ts",
      "import": "./dist/auth-adapter.js"
    }
  },
  "scripts": {
    "build": "vp pack && node scripts/copy-migrations.mjs",
    "check": "tsc --noEmit",
    "queue:bootstrap": "node --enable-source-maps dist/bootstrap.js",
    "db:manifest": "node scripts/migration-manifest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@kairn/contracts": "workspace:*",
    "@kairn/shared": "workspace:*",
    "@kairn/sync-protocol": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "gel": "2.2.1",
    "mysql2": "3.24.6",
    "typescript": "7.0.2"
  }
}
