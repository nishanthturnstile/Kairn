{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "vite.config.ts",
    "config/**/*.ts",
    "scripts/**/*.mjs",
    "packages/*/vite*.ts",
    "packages/*/scripts/**/*.mjs",
    "apps/*/vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
